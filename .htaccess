# INGBOEX Website Security & HTTPS Configuration
# For Apache / Litespeed servers (supports .htaccess)

# ============================================
# 1. Force HTTPS Redirect
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Redirect all HTTP traffic to HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    # Redirect www to non-www (or vice versa - choose one)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
</IfModule>

# ============================================
# 2. HTTP Strict Transport Security (HSTS)
# ============================================
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # ============================================
    # 3. Content Security Policy (CSP)
    # ============================================
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; media-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; connect-src 'self' https://formsubmit.co; form-action 'self' https://formsubmit.co;"

    # ============================================
    # 4. X-Frame-Options (Clickjacking Protection)
    # ============================================
    Header always set X-Frame-Options "DENY"

    # ============================================
    # 5. X-Content-Type-Options (MIME Sniffing)
    # ============================================
    Header always set X-Content-Type-Options "nosniff"

    # ============================================
    # 6. Referrer-Policy
    # ============================================
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # ============================================
    # 7. Permissions-Policy
    # ============================================
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # ============================================
    # 8. X-XSS-Protection (Legacy browsers)
    # ============================================
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ============================================
# 9. Security File Access Restrictions
# ============================================
# Block access to sensitive files
<FilesMatch "(^\.|\.(git|svn|env|sql|bak|log|ini|sh|conf))$">
    Require all denied
</FilesMatch>

# Block access to hidden files (dotfiles)
<FilesMatch "^\.(git|gitignore|env|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# Protect against XML external entity (XXE) attacks
<IfModule mod_xml2enc.c>
    SetOutputFilter xml2enc
</IfModule>

# ============================================
# 10. MIME Type Corrections
# ============================================
<IfModule mod_mime.c>
    AddType application/json .json
    AddType application/xml .xml
    AddType text/cache-manifest .appcache
    AddType image/svg+xml .svg
    AddType video/mp4 .mp4
    AddType application/pdf .pdf
</IfModule>

# ============================================
# 11. Character Encoding
# ============================================
<IfModule mod_mime.c>
    AddDefaultCharset UTF-8
    AddCharset UTF-8 .html .css .js .xml .json .rss
</IfModule>

# ============================================
# 12. Compression (Gzip)
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2
    # Don't compress already compressed files
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|ico|mp4|pdf|zip|gz)$ no-gzip
</IfModule>

# ============================================
# 13. Browser Caching
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML - short cache (content updates frequently)
    ExpiresByType text/html "access plus 0 seconds"
    # CSS/JS - 30 days
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    # Images - 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    # Fonts - 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    # Video - 30 days
    ExpiresByType video/mp4 "access plus 30 days"
    # PDF - 30 days
    ExpiresByType application/pdf "access plus 30 days"
    # Disable caching for sitemap and robots
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
</IfModule>

# Cache-Control headers (for CDNs/proxies)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|woff2|mp4|pdf)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|xml|txt)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ============================================
# 14. Directory Listing Protection
# ============================================
Options -Indexes

# ============================================
# 15. Custom Error Pages
# ============================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ============================================
# 16. Remove Server Signature
# ============================================
ServerSignature Off
